# Configuración del Backend

# Puerto del servidor
PORT=3000

# URL del frontend (para CORS en producción)
FRONTEND_URL=https://tu-frontend.vercel.app

# Configuración de Telegram (OPCIONAL)
# Para obtener estas credenciales:
# 1. Abre Telegram y busca @BotFather
# 2. Envía /newbot y sigue las instrucciones
# 3. Copia el TOKEN que te da
# 4. Para obtener tu CHAT_ID, busca @userinfobot y envía cualquier mensaje
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configuración de Twilio para WhatsApp (OPCIONAL)
# Para obtener estas credenciales:
# 1. Regístrate en https://www.twilio.com
# 2. Ve a Console Dashboard para obtener Account SID y Auth Token
# 3. Para WhatsApp sandbox: https://www.twilio.com/console/sms/whatsapp/sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Números de WhatsApp destino separados por coma (formato: whatsapp:+5493624643450)
TWILIO_WHATSAPP_TO=

# Umbral mínimo para alertas (por defecto 32%)
UMBRAL_MIN=32
